<%= form_with model: Group::Message.new,
              url: group_messages_path,
              data: {
                turbo_stream: true,
                controller: "conversation--reset-form",
                action: "turbo:submit-end->conversation--reset-form#reset"
              },
              class: "send-private-message" do |f| %>

  <%= f.hidden_field :conversation_id, value: conversation.id %>

  <%= f.text_area :content,
                  rows: 2,
                  class: "form-control",
                  placeholder: "Type a message..." %>

  <%= f.submit "Send", class: "btn btn-success mt-1" %>
<% end %>

