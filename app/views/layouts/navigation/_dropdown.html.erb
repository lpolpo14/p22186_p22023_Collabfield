<ul class="dropdown-menu dropdown-menu-end">
    <% navbar_conversations.each do |conversation| %>
      <% other = conversation.opposed_user(current_user) %>

      <li>
        <%= link_to other.name,
              private_conversation_open_path(conversation),  # you’ll add this route/action
              class: "dropdown-item",
              data: { turbo_stream: true } %>
      </li>
    <% end %>

    <% if navbar_conversations.empty? %>
      <li><span class="dropdown-item-text text-muted">No conversations yet</span></li>
    <% end %>
  </ul>
