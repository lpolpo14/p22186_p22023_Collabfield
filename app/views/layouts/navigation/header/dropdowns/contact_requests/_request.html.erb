<li>
  <div class="dropdown-item d-flex justify-content-between align-items-center text-white w-100">
    <span><%= user.name %></span>

    <div class="ms-2">
      <%= link_to "Accept",
                  contact_path(id: user.id),
                  class: "btn btn-sm btn-success",
                  data: { turbo_method: :put } %>

      <%= link_to "Decline",
                  contact_path(id: user.id),
                  class: "btn btn-sm btn-outline-light",
                  data: { turbo_method: :delete } %>
    </div>
  </div>
</li>

