<%= turbo_stream.replace "contact-request-status-#{params[:contact_id]}" do %>
  <% recipient = User.find(params[:contact_id]) %>
  <% contact = Contact.find_by_users(current_user.id, recipient.id) %>

  <%= render "private/conversations/conversation/request_status",
             recipient: recipient,
             contact: contact %>
<% end %>

