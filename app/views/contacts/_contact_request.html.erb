<!-- app/views/contacts/_contact_request.html.erb -->
<li id="contact_request_<%= user.id %>" class="contact-request">
  <div class="sixty-percent">
    <span class="contact-name"><%= user.name %></span>
  </div>

  <div class="forty-percent">
    <span class="accept-request">
      <%= link_to "Accept",
                  contact_path(id: user.id),
                  data: { turbo_method: :put } %>
    </span>

    <span class="decline-request">
      <%= link_to "Decline",
                  contact_path(id: user.id),
                  data: { turbo_method: :delete } %>
    </span>
  </div>
</li>

