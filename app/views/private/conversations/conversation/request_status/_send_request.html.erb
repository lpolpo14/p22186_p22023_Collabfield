<div class="contact-request-status">
  <div class="add-user-to-contacts-message">
    <div><%= recipient.name %> is not in your contacts</div>
    <div>
      <%= link_to "Add to contacts",
                  contacts_path(contact_id: recipient.id),
                  data: { turbo_method: :post, turbo_stream: true },
                  class: "add-user-to-contacts-notif" %>
    </div>
  </div>
</div>

