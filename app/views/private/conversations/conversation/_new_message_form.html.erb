<%= form_with model: [ :private, Private::Message.new ],
              url: private_messages_path,
              data: {
                controller: "conversation--reset-form",
                action: "turbo:submit-end->conversation--reset-form#reset"
              }, 
              class: "send-private-message" do |f| %>

  <%= hidden_field_tag :conversation_id, conversation.id %>

  <%= f.text_area :body,
                  rows: 2,
                  class: "form-control",
                  placeholder: "Type a message..." %>

  <%= f.submit "Send",
               class: "btn btn-success mt-1" %>
<% end %>

