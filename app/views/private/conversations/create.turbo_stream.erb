<%= turbo_stream.replace "contact-user" do %>
  <div class="contact-user">
    <div class="contacted-user">
      Message has been sent
    </div>
  </div>
<% end %>

<% unless @already_added %>
  <%= turbo_stream.append "chat-windows" do %>
    <%= render "private/conversations/conversation",
               conversation: @conversation,
               user: current_user %>
  <% end %>
<% end %>

