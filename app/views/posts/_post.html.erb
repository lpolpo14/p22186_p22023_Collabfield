<div class="col-12 col-md-6 col-lg-4 mb-4"
     data-controller="post-cards"
     data-post-cards-target="card"
     data-post-modal-target="trigger"
     data-action="click->post-modal#open"
     data-post-modal-posted-by="<%= post.user.name %>"
     data-post-modal-title="<%= post.title %>"
     data-post-modal-content="<%= post.content %>"
     data-post-modal-interest-path="<%= post_path(post.id) %>"
     data-post-modal-id="<%= post.id %>">

  <div class="card h-100 post-card-inner">
    <div class="card-body">
      <h4 class="card-title"><%= truncate(post.title, length: 60) %></h4>
      <p class="card-text"><%= truncate(post.content, length: 100) %></p>
    </div>
    <div class="card-footer text-muted">
      <small>Posted by <%= post.user.name %></small>
    </div>
  </div>
</div>
