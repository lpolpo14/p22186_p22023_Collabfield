<!-- Modal -->
  <div class="modal fade"
     data-post-modal-target="modal"
     tabindex="-1"
     aria-hidden="true">
  
  <div class="modal-dialog modal-lg" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <span data-post-modal-target="postedBy"></span>
        <button type="button" 
                class="btn-close"
                data-action="click->post-modal#close"
                data-bs-dismiss="modal" 
                aria-label="Close">
        </button>
      </div>
      <div class="modal-body">
        <div class="loaded-data">
          <h3 data-post-modal-target="title"></h3>
          <p data-post-modal-target="content"></p>
          <div class="interested">
            <a data-post-modal-target="interestLink">I'm interested</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
