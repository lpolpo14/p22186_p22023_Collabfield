
  <%= form_with url: private_conversations_path, method: :post do %>

  <%= hidden_field_tag :post_id, @post.id %>

  <%= text_area_tag :message_body,
                    nil,
                    rows: 3,
                    class: 'form-control',
                    placeholder: 'Send a message to the user',
                    required: true %>

  <%= submit_tag 'Send a message',
                 class: 'btn send-message-to-user' %>

<% end %>

