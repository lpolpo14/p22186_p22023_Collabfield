<% branch_path_name = "#{params[:action]}_posts_path" %>

<div class="col-12">
  <div class="d-flex flex-wrap gap-2">
    
    <%# All Categories button %>
    <%= link_to "All", 
                send(branch_path_name), 
                class: "btn #{params[:category].blank? ? 'btn-primary' : 'btn-outline-primary'}" %>

    <%# Category buttons %>
    <% @categories.each do |category| %>
      <%= link_to category.name,
                  send(branch_path_name, category: category.name),
                  class: "btn #{params[:category] == category.name ? 'btn-primary' : 'btn-outline-primary'}" %>
    <% end %>

  </div>
</div>
